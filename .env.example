# Copy to .env and adjust. `npm start`, `npm run dev`, start.sh and docker compose all read it.
# Never commit .env (it is gitignored).

# --- Server ---
PORT=5180
HOST=0.0.0.0
# Where SQLite DB, uploads and generated images live (default ./data)
# WB_DATA_DIR=./data
# Time zone used to name shoot batches (YYYYMMDD folders); default = server local time
# WB_TZ=Asia/Shanghai
# Parallel generation jobs
WB_CONCURRENCY=2
# Max upload size in MB
WB_UPLOAD_MAX_MB=60
# info | debug | silent
WB_LOG_LEVEL=info

# --- Access gate ---
# Shared password for the whole site. Leave empty ONLY on a trusted machine/LAN.
WB_ACCESS_PASSWORD=
# Behind a reverse proxy (nginx, Caddy, Cloudflare Tunnel…) set this so the login rate limit sees real client IPs,
# e.g. "loopback" or "1". Leave empty when clients connect directly.
WB_TRUST_PROXY=
# Force the Secure cookie flag (set to 1 when served over HTTPS through a proxy)
WB_COOKIE_SECURE=0

# --- Model channels ---
# Channel for newly created canvas nodes: grok (external import, free) | mock | openai | fal | http | comfyui
# Empty = mock (free placeholder backgrounds). The chosen channel must also be enabled in Settings;
# if it isn't, mock is used. Example: grok (manual/external import), openai, comfyui.
WB_DEFAULT_PROVIDER=

# OpenAI GPT Image (direct). Only read from here — never stored in the DB or shown in the UI.
# OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint (proxy / gateway). Configured here, not in the UI, so the key can't be redirected.
# OPENAI_BASE_URL=https://api.openai.com/v1

# fal.ai (GPT Image 2.5 hosted on fal). Only FAL_KEY is used — there is no fallback to other variables.
# FAL_KEY=

# Generic HTTP channel: put the key in a variable whose name starts with WB_HTTP_ and enter that NAME in Settings.
# WB_HTTP_API_KEY=
